{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "SentryDeobfProxy.Services": "Information",
            "SentryDeobfProxy.Repositories": "Information",
            "SentryDeobfProxy.Controllers": "Information"
        }
    },
    "AllowedHosts": "*",
    "Sentry": {
        "RealDsn": "set-via-environment-variable-Sentry__RealDsn",
        "MappingPath": "set-via-environment-variable-Sentry__MappingPath",
        "PlaceholderPublicKey": "fakekey1234567890abcdef1234567890ab"
    },
    "Authentication": {
        "ApiKey": "set-via-environment-variable-Authentication__ApiKey"
    }
}